generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  plan             PlanType          @default(FREE)
  currency         String            @default("SAR")
  paymobCustomerId String?           @unique
  trialEndsAt      DateTime?
  aiDialect        AIDialect         @default(FUSHA)
  accounts         Account[]
  activityLogs     ActivityLog[]
  chatSessions     ChatSession[]
  customers        Customer[]
  customerPayments CustomerPayment[]
  expenses         Expense[]
  inventoryCounts  InventoryCount[]
  invoices         Invoice[]
  invoiceSettings  InvoiceSettings?
  journalEntries   JournalEntry[]
  products         Product[]
  purchases        PurchaseOrder[]
  redemptions      Redemption[]
  returns          Return[]
  sales            Sale[]
  stocks           Stock[]
  subscriptions    Subscription[]
  trialOverride    TrialOverride?
  users            User[]
  warehouses       Warehouse[]

  @@index([slug])
}

model Plan {
  id                  String         @id @default(cuid())
  name                String         @unique
  type                PlanType
  price               Decimal
  features            Json
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  paymobIntegrationId String?        @unique
  subscriptions       Subscription[]
}

model Subscription {
  id                  String             @id @default(cuid())
  tenantId            String
  planId              String
  status              SubscriptionStatus @default(active)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  paymobOrderId       String?            @unique
  paymobTransactionId String?            @unique
  payments            Payment[]
  plan                Plan               @relation(fields: [planId], references: [id])
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Payment {
  id                  String       @id @default(cuid())
  subscriptionId      String
  amount              Decimal
  currency            String       @default("usd")
  status              String
  paidAt              DateTime?
  createdAt           DateTime     @default(now())
  paymobTransactionId String?      @unique
  subscription        Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model InvoiceSettings {
  id                  String  @id @default(cuid())
  tenantId            String  @unique
  logoUrl             String?
  primaryColor        String? @default("#000000")
  fontFamily          String? @default("Inter")
  templateStyle       String  @default("modern")
  showTax             Boolean @default(true)
  showDiscount        Boolean @default(true)
  showSeller          Boolean @default(true)
  footerNotes         String?
  accentColor         String? @default("#4F46E5")
  companyAddress      String?
  companyEmail        String?
  companyPhone        String?
  fontSize            String? @default("medium")
  showCustomerSection Boolean @default(true)
  tenant              Tenant  @relation(fields: [tenantId], references: [id])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  role         Role          @default(STAFF)
  isActive     Boolean       @default(true)
  deletedAt    DateTime?
  tenantId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  canDeferred  Boolean       @default(false)
  activityLogs ActivityLog[]
  sales        Sale[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
}

model Customer {
  id        String            @id @default(cuid())
  name      String
  phone     String?
  email     String?
  tenantId  String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  payments  CustomerPayment[]
  sales     Sale[]
}

model CustomerPayment {
  id         String   @id @default(cuid())
  amount     Decimal
  date       DateTime @default(now())
  reference  String?
  customerId String
  tenantId   String
  customer   Customer @relation(fields: [customerId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([tenantId])
}

model Warehouse {
  id              String           @id @default(cuid())
  name            String
  location        String?
  tenantId        String
  inventoryCounts InventoryCount[]
  purchases       PurchaseOrder[]
  stocks          Stock[]
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
}

model Product {
  id                  String               @id @default(cuid())
  name                String
  sku                 String
  description         String?
  price               Decimal
  cost                Decimal
  minStock            Int                  @default(0)
  tenantId            String
  inventoryCountLines InventoryCountLine[]
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  purchaseItems       PurchaseItem[]
  returnItems         ReturnItem[]
  saleItems           SaleItem[]
  stocks              Stock[]

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@index([tenantId, price])
}

model Stock {
  id          String    @id @default(cuid())
  quantity    Int       @default(0)
  productId   String
  warehouseId String
  tenantId    String
  product     Product   @relation(fields: [productId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, productId])
}

model Sale {
  id             String      @id @default(cuid())
  number         Int
  total          Decimal
  status         String      @default("COMPLETED")
  date           DateTime    @default(now())
  userId         String
  tenantId       String
  customerId     String?
  journalEntryId String?
  amountPaid     Decimal     @default(0)
  paymentType    PaymentType @default(CASH)
  paymobOrderId  String?     @unique
  invoice        Invoice?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  user           User        @relation(fields: [userId], references: [id])
  items          SaleItem[]

  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@index([userId])
  @@index([customerId])
  @@index([status])
}

model SaleItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Decimal
  cost      Decimal
  productId String
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id])
}

model Invoice {
  id             String   @id @default(cuid())
  jsonSnapshot   Json
  pdfUrl         String?
  saleId         String   @unique
  tenantId       String
  createdAt      DateTime @default(now())
  customerName   String?
  discountAmount Decimal  @default(0)
  discountType   String?
  discountValue  Decimal?
  notes          String?
  status         String   @default("COMPLETED")
  subtotal       Decimal  @default(0)
  taxAmount      Decimal  @default(0)
  taxRate        Decimal?
  token          String?  @unique @default(cuid())
  total          Decimal  @default(0)
  updatedAt      DateTime @default(now()) @updatedAt
  sale           Sale     @relation(fields: [saleId], references: [id])
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  returns        Return[]

  @@index([token])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model Return {
  id             String       @id @default(cuid())
  token          String       @unique
  invoiceId      String
  tenantId       String
  returnType     String
  reason         String
  notes          String?
  itemsTotal     Decimal
  discountShare  Decimal
  refundAmount   Decimal
  status         String       @default("PENDING")
  paymentType    PaymentType  @default(CASH)
  processedAt    DateTime?
  processedBy    String?
  journalEntryId String?
  createdAt      DateTime     @default(now())
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  items          ReturnItem[]

  @@index([invoiceId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model ReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  productId String
  quantity  Int
  price     Decimal
  cost      Decimal
  product   Product @relation(fields: [productId], references: [id])
  return    Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id             String         @id @default(cuid())
  number         Int
  supplier       String?
  total          Decimal
  date           DateTime       @default(now())
  status         String         @default("RECEIVED")
  tenantId       String
  journalEntryId String?
  warehouseId    String
  items          PurchaseItem[]
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@index([supplier])
  @@index([status])
}

model PurchaseItem {
  id         String        @id @default(cuid())
  quantity   Int
  cost       Decimal
  productId  String
  purchaseId String
  product    Product       @relation(fields: [productId], references: [id])
  purchase   PurchaseOrder @relation(fields: [purchaseId], references: [id])
}

model Expense {
  id             String   @id @default(cuid())
  description    String
  amount         Decimal
  date           DateTime @default(now())
  category       String
  tenantId       String
  journalEntryId String?
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
}

model Account {
  id       String        @id @default(cuid())
  code     String
  name     String
  tenantId String
  type     AccountType
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  entries  Transaction[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
}

model JournalEntry {
  id           String        @id @default(cuid())
  date         DateTime      @default(now())
  description  String
  reference    String?
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id             String          @id @default(cuid())
  amount         Decimal
  accountId      String
  journalEntryId String
  type           TransactionType
  account        Account         @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry    @relation(fields: [journalEntryId], references: [id])
}

model InventoryCount {
  id          String               @id @default(cuid())
  date        DateTime             @default(now())
  status      String
  notes       String?
  warehouseId String
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id])
  lines       InventoryCountLine[]
}

model InventoryCountLine {
  id         String         @id @default(cuid())
  productId  String
  systemQty  Int
  countedQty Int
  difference Int
  countId    String
  count      InventoryCount @relation(fields: [countId], references: [id])
  product    Product        @relation(fields: [productId], references: [id])
}

model TrialOverride {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  plan      PlanType
  expiresAt DateTime
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  resource  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model PromoCode {
  id          String       @id @default(cuid())
  code        String       @unique
  planType    PlanType
  expiresAt   DateTime?
  maxUses     Int?
  currentUses Int          @default(0)
  isActive    Boolean      @default(true)
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  redemptions Redemption[]

  @@index([code])
  @@index([isActive])
}

model Redemption {
  id          String    @id @default(cuid())
  promoCodeId String
  tenantId    String
  redeemedAt  DateTime  @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([promoCodeId])
  @@index([tenantId])
}

model ChatSession {
  id        String        @id @default(cuid())
  tenantId  String
  status    String        @default("ACTIVE")
  startedAt DateTime      @default(now())
  endsAt    DateTime
  endedAt   DateTime?
  messages  ChatMessage[]
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([endsAt])
}

model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  sender     String
  senderName String?
  content    String
  createdAt  DateTime    @default(now())
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  type      String    @default("INFO")
  target    String    @default("ALL")
  isActive  Boolean   @default(true)
  link      String?
  linkText  String?
  expiresAt DateTime?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive])
  @@index([target])
}

model GlobalSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}

model PlatformAdmin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String?
  role      String   @default("SUPER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
}

model AIKnowledge {
  id        String   @id @default(cuid())
  tenantId  String?
  question  String
  answer    String
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([isActive])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum PlanType {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  pending
}

enum PaymentType {
  CASH
  BANK_TRANSFER
  DEFERRED
  ONLINE
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
  REFUNDED
}

enum AIDialect {
  FUSHA
  EGYPTIAN
  SAUDI
  EMIRATI
}
